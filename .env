# Option 3: Local PostgreSQL Configuration (when Supabase is unavailable)
LOCAL_DB_URL=jdbc:postgresql://localhost:5432/postgres
LOCAL_DB_USERNAME=postgres
LOCAL_DB_PASSWORD=postgres

# ==============================================================================
# JWT Authentication Secret
# MUST BE at least 256 bits (32+ alphanumeric characters or base64)
# ==============================================================================
JWT_SECRET=YourSuperSecretKeyForStepStyleJwtSigningMustBeAtLeast32BytesLong123456
JWT_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# CORS Allowed Origins (Comma-separated for multiple origins)
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:4201,http://127.0.0.1:4200,http://127.0.0.1:4201

# Supabase Hikari Transaction Isolation (PgBouncer compatibility)
spring.datasource.hikari.transaction-isolation=TRANSACTION_READ_COMMITTED

# Admin Bootstrap (Default System Administrator)
ADMIN_BOOTSTRAP_ENABLED=true
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=Password@123
ADMIN_BOOTSTRAP_EMAIL=admin@stepstyle.com

# File Upload Directory
UPLOAD_DIR=uploads/products

# ==============================================================================
# Supabase Storage Configuration (Store product images in Supabase Storage)
# ==============================================================================
SUPABASE_URL=https://rlryucrhtugglzefnwxq.supabase.co
SUPABASE_STORAGE_BUCKET=product-images
# Place your Supabase service_role secret key below (Supabase Dashboard -> Project Settings -> API -> service_role secret)
SUPABASE_SERVICE_ROLE_KEY=

# Email Service Configuration (SMTP)
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=your_smtp_username_here
MAIL_PASSWORD=your_smtp_password_here
MAIL_FROM=noreply@stepstyle.com
MAIL_DEV_MODE=true

# Frontend URL for Password Reset Link
FRONTEND_RESET_PASSWORD_URL=http://localhost:4200/reset-password
